{
  "name": "@recipes/root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@recipes/root",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "node_modules/@recipes/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@recipes/corpus": {
      "resolved": "packages/corpus",
      "link": true
    },
    "packages/core": {
      "name": "@recipes/core",
      "version": "0.0.0"
    },
    "packages/corpus": {
      "name": "@recipes/corpus",
      "version": "0.0.0",
      "dependencies": {
        "@recipes/core": "*"
      }
    }
  }
}
